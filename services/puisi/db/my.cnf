[mysqld]
# Identitas dan replikasi GTID wajib untuk InnoDB Cluster (MySQL 8.4)
gtid_mode = ON
enforce_gtid_consistency = ON
binlog_checksum = NONE
log_replica_updates = ON
binlog_format = ROW
disabled_storage_engines = "MyISAM,BLACKHOLE,FEDERATED,ARCHIVE,MEMORY"

# Optimasi RAM untuk laptop 16 GB (3 node berjalan bersamaan)
# performance_schema wajib ON karena dipakai tabel replication_group_members oleh MySQL Router
performance_schema = ON
innodb_buffer_pool_size = 64M
innodb_log_buffer_size = 8M
max_connections = 100
table_open_cache = 400
table_definition_cache = 400
skip_name_resolve = ON

