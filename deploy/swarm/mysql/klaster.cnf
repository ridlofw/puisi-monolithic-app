# Pengaturan umum node MySQL untuk InnoDB Cluster auth-db dan tts-db (Swarm config).
# Hanya server-id dan report-host yang berbeda per node; keduanya diberikan lewat `command`
# di stack.yaml. Pengaturan ini sama dengan opsi `command` milik poem-db-1..3
# (compose/puisi.yaml), dipindahkan ke berkas supaya stack.yaml tidak berulang-ulang.
[mysqld]
gtid_mode = ON
enforce_gtid_consistency = ON
binlog_checksum = NONE
log_replica_updates = ON
binlog_format = ROW
disabled_storage_engines = "MyISAM,BLACKHOLE,FEDERATED,ARCHIVE,MEMORY"
performance_schema = ON
innodb_buffer_pool_size = 64M
innodb_log_buffer_size = 8M
max_connections = 100
skip_name_resolve = ON
